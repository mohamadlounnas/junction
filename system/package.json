{
  "name": "smart-contact-system",
  "version": "1.0.0",
  "description": "AI-Powered Real Estate Recommendation System for Algeria",
  "main": "src/index.ts",
  "scripts": {
    "dev": "bun src/index.ts",
    "dev:watch": "bun --watch src/index.ts",
    "build": "bun build src/index.ts --outdir ./dist --target bun",
    "start": "bun run dist/index.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "bun run src/scripts/seed.ts",
    "test": "bun test src/tests/api.test.ts",
    "test:watch": "bun test --watch src/tests/api.test.ts",
    "test:vector": "bun run src/tests/vector.test.ts",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write src/**/*.ts",
    "deploy": "bun run build && bun run start",
    "health": "curl -s http://localhost:3001/health"
  },
  "keywords": [
    "real-estate",
    "ai",
    "recommendations",
    "algeria",
    "vector-search",
    "elysia",
    "machine-learning",
    "12d-vectors",
    "similarity-matching"
  ],
  "author": "Smart Contact Team",
  "license": "MIT",
  "dependencies": {
    "@elysiajs/cors": "^0.8.0",
    "@elysiajs/static": "^0.8.0",
    "@elysiajs/swagger": "^0.8.0",
    "@prisma/client": "^5.7.1",
    "@types/puppeteer": "^7.0.4",
    "elysia": "^0.8.17",
    "html2canvas": "^1.4.1",
    "jspdf": "^3.0.1",
    "prisma": "^5.7.1",
    "puppeteer": "^24.14.0",
    "redis": "^4.6.12",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "bun-types": "latest",
    "typescript": "^5.3.3",
    "eslint": "^8.56.0",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "prettier": "^3.1.1"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/smart-contact/algeria-system.git"
  },
  "bugs": {
    "url": "https://github.com/smart-contact/algeria-system/issues"
  },
  "homepage": "https://github.com/smart-contact/algeria-system#readme"
}
