# Smart Contact System - Environment Configuration

# Database Configuration
DATABASE_URL="postgresql://user:password@localhost:5432/smart_contact"

# Redis Configuration (for caching and performance)
REDIS_URL="redis://localhost:6379"

# API Configuration
PORT=3001
NODE_ENV=development

# AI/ML Configuration
VECTOR_DIMENSIONS=16
DEFAULT_RECOMMENDATION_LIMIT=20
SIMILARITY_THRESHOLD=0.3

# Algeria Market Configuration
SUPPORTED_WILAYAS="Algiers,Oran,Constantine,Annaba,Blida,Batna,Djelfa,Sétif,Sidi Bel Abbès,Biskra"
DEFAULT_CURRENCY="DZD"
DEFAULT_LANGUAGE="fr"

# PDF Generation
PDF_STORAGE_PATH="./storage/quotes"
PDF_BASE_URL="http://localhost:3001/quotes"

# ERP Integration (for future use)
ERP_API_URL=""
ERP_API_KEY=""
ERP_SYNC_INTERVAL=3600

# Performance Optimization
CACHE_TTL=300
MAX_RECOMMENDATIONS_BATCH=1000
RECOMMENDATION_CACHE_TTL=900

# Security
API_KEY_HEADER="X-API-Key"
RATE_LIMIT_WINDOW=900
RATE_LIMIT_MAX_REQUESTS=1000

# Monitoring and Logging
LOG_LEVEL=info
ENABLE_METRICS=true
METRICS_PORT=9090 