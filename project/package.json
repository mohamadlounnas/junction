{
  "name": "smart-contact-api",
  "version": "1.0.0",
  "description": "AI-powered real estate recommendation system",
  "main": "dist/index.js",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target node",
    "start": "bun run dist/index.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "bun run scripts/seed.ts",
    "db:test": "bun run scripts/test.ts",
    "test": "bun test",
    "test:admin": "bun run scripts/test-admin-settings.ts",
    "test:score-search": "bun run scripts/test-score-search.ts",
    "db:migrate-vectors": "bun run scripts/migrate-to-algeria-vectors.ts"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.3.3",
    "@elysiajs/swagger": "^1.3.1",
    "@prisma/client": "^5.7.1",
    "elysia": "^1.3.5",
    "ioredis": "^5.6.1",
    "redis": "^5.6.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "bun-types": "latest",
    "prisma": "^5.7.1",
    "typescript": "^5.3.0"
  },
  "engines": {
    "bun": ">=1.0.0"
  }
}
